# Copiar a .env.local y rellenar con los datos del proyecto de Supabase.
# .env.local NO se versiona: está en .gitignore.
#
# Las dos son públicas por diseño: la llave anónima no da acceso a nada por
# sí sola, porque quien decide qué se puede leer es RLS en Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service_role NO va acá ni en ninguna variable NEXT_PUBLIC_*.
# Todo lo que lleve ese prefijo llega al navegador de cualquiera.
